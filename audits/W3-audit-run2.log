  48:       // pelo topo (o footer Ã© a Ãºltima dobra: fica num trecho parcial).
  49:       const progress = Math.min(
  50:         1,
  51:         Math.max(0, (vh - rect.top) / (vh + rect.height)),
  52:       );
  53:       const y =
  54:         Math.round((HAT_FROM + (HAT_TO - HAT_FROM) * progress) * 100) / 100;
  55:       if (y !== lastY) {
  56:         lastY = y;
  57:         inner.style.transform = `translate3d(0, ${y}%, 0)`;
  58:       }
  59:       raf = requestAnimationFrame(frame);
  60:     };
  61: 
  62:     const io = new IntersectionObserver((entries) => {
  63:       const entry = entries[entries.length - 1];
  64:       if (!entry) return;
  65:       cancelAnimationFrame(raf);
  66:       if (entry.isIntersecting) {
  67:         raf = requestAnimationFrame(frame);
  68:       }
  69:     });
  70:     io.observe(root);
  71: 
  72:     return () => {
  73:       io.disconnect();
  74:       cancelAnimationFrame(raf);
  75:       inner.style.transform = "";
  76:     };
  77:   }, [motionOk]);
  78: 
  79:   return (
  80:     <div ref={rootRef} className={styles.hat} aria-hidden="true">
  81:       <span ref={innerRef} className={styles.hatInner}>
  82:         {text}
  83:       </span>
  84:     </div>
  85:   );
  86: }
