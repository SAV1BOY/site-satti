/* ============================================================
   Reviews (S10 Â· Depoimentos) â€” grade estÃ¡tica 3 cards / paper
   Comp: padding 96/â€¦/120 (348px direito = scaffold, descartado Â§4)
   Â· eyebrow 8Ã—8 Â· h2 800 clamp(2.5-4rem) 1.02 âˆ’0.01em max 18ch Â·
   aviso mono 11 steel com dot 6px Â· grid 3Ã—1fr gap 24 Â· card
   hairline radius 28 padding 40 min-h 420 Â· aspas 900 64px blaze
   (1/card, conforme comp) Â· avatar 52px blueprint Â· nome 15/600
   iron Â· cargo mono 11 steel. Mobile 375: padding 40/20/48 Â·
   tÃ­tulo 32px Â· 1 col gap 18 Â· card radius 24 padding 28.
   SeÃ§Ã£o 100% estÃ¡tica â€” nenhum motion prÃ³prio (L5 por construÃ§Ã£o).
   ============================================================ */

.root {
  position: relative;
  background: var(--c-paper);
  color: var(--c-iron);
  padding: 96px clamp(20px, 6.25vw, 120px) 120px;
}

.eyebrow {
  margin-bottom: 18px;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 32px;
  margin-bottom: 56px;
}

.title {
  margin: 0;
  font-family: var(--ff-display);
  font-weight: 800;
  text-transform: uppercase;
  font-size: clamp(2.5rem, 5vw, 4rem);
  line-height: 1.02;
  letter-spacing: -0.01em;
  max-width: 18ch;
}

.notice {
  margin: 0;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex: none;
  font-family: var(--ff-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--c-steel);
}

.notice::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: var(--r-pill);
  background: var(--c-steel);
  flex: none;
}

.grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 28px;
  border: 1px solid var(--c-line);
  border-radius: var(--r-xl);
  background: var(--c-paper);
  padding: 40px;
  min-height: 420px;
}

/* Aspas blaze â€” 1 por card, conforme a comp aprovada */
.quoteMark {
  display: block;
  font-family: var(--ff-display);
  font-weight: 900;
  font-size: 64px;
  line-height: 0.6;
  height: 32px;
  color: var(--c-blaze);
}

.quote {
  margin: 0;
  flex: 1;
  font-size: 19px;
  line-height: 1.55;
  color: var(--c-iron);
}

/* Placeholder [CONFIRMAR]: steel, como na comp (L1/draft) */
.quote[data-confirm="true"] {
  color: var(--c-steel);
}

.person {
  display: flex;
  align-items: center;
  gap: 16px;
  border-top: 1px solid var(--c-line);
  padding-top: 24px;
}

/* Avatar blueprint 52px (grade 13px hairline â€” sem foto atÃ© W6/L1) */
.avatar {
  width: 52px;
  height: 52px;
  flex: none;
  border-radius: var(--r-pill);
  border: 1px solid var(--c-line);
  background-color: var(--tint-slate);
  background-image:
    linear-gradient(var(--c-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
  background-size: 13px 13px;
}

.personMeta {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.name {
  font-size: 15px;
  font-weight: 600;
  color: var(--c-iron);
}

.role {
  font-family: var(--ff-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--c-steel);
}

@media (max-width: 767px) {
  .root {
    padding: 40px 20px 48px;
  }

  .head {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
  }

  .title {
    font-size: 32px;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .card {
    border-radius: 24px;
    padding: 28px;
    min-height: 0;
  }
}


