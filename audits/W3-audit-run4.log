diff --git a/audits/W3-verdict.md b/audits/W3-verdict.md
index 6dd384a252189fdd18318e54111d5cce3724e8d7..33d6cc540da7b7210cd383f6d8de82e1eacac77f
--- a/audits/W3-verdict.md
+++ b/audits/W3-verdict.md
@@ -4,5 +4,5 @@
 
 | Item | Veredito | Evidência |
