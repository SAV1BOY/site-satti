   8:   useMemo,
   9:   useRef,
  10:   useState,
  11:   type ReactNode,
  12: } from "react";
  13: 
  14: /**
  15:  * OverlayProvider â€” estado e chrome comum dos overlays O1/O2/O3 (W4).
  16:  *
  17:  * ComposiÃ§Ã£o: os overlays sÃ£o SERVER components (copy via getTranslations)
  18:  * passados como slots; este provider (client) sÃ³ decide QUAL slot estÃ¡
  19:  * visÃ­vel e cuida do chrome de acessibilidade:
  20:  * - Esc fecha Â· foco vai para o painel ao abrir e VOLTA ao trigger ao fechar
  21:  * - trap de Tab dentro do painel ativo
  22:  * - scroll da pÃ¡gina travado enquanto houver overlay (html[data-overlay])
  23:  * - histÃ³rico de triggers via ref (nÃ£o estado â€” sem re-render extra)
  24:  *
  25:  * Triggers (DEC-011): hambÃºrguer do header â†’ O1; item de contato do O1 â†’
  26:  * O2; linha de idioma do O1 (e o seletor do header, opcional) â†’ O3.
  27:  * Fora de um provider, useOverlay() Ã© inerte (dev/ui, testes).
  28:  */
  29: 
  30: export type OverlayId = "menu" | "contact" | "language";
  31: 
  32: interface OverlayContextValue {
  33:   active: OverlayId | null;
  34:   open: (id: OverlayId) => void;
  35:   close: () => void;
  36: }
  37: 
  38: const OverlayContext = createContext<OverlayContextValue | null>(null);
  39: 
  40: const FOCUSABLE =
  41:   'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
  42: 
  43: export function useOverlay(): OverlayContextValue {
  44:   const ctx = useContext(OverlayContext);
  45:   const inert = useMemo<OverlayContextValue>(
  46:     () => ({ active: null, open: () => undefined, close: () => undefined }),
  47:     [],
  48:   );
  49:   return ctx ?? inert;
  50: }
  51: 
  52: interface OverlayProviderProps {
  53:   children: ReactNode;
  54:   /** O1 â€” menu fullscreen graphite (server-rendered). */
  55:   menu: ReactNode;
  56:   /** O2 â€” painel de contato lateral direito (server-rendered). */
  57:   contact: ReactNode;
  58:   /** O3 â€” seletor de idioma (server-rendered). */
  59:   language: ReactNode;
  60: }
  61: 
  62: export default function OverlayProvider({
  63:   children,
  64:   menu,
  65:   contact,
  66:   language,
  67: }: OverlayProviderProps) {
  68:   const [active, setActive] = useState<OverlayId | null>(null);
  69:   const activeRef = useRef<OverlayId | null>(null);
  70:   const panelRef = useRef<HTMLDivElement | null>(null);
  71:   const triggerRef = useRef<HTMLElement | null>(null);
  72: 
  73:   useEffect(() => {
  74:     activeRef.current = active;
  75:   }, [active]);
  76: 
  77:   const open = useCallback((id: OverlayId) => {
  78:     // SÃ³ grava o trigger ao abrir a partir da PÃGINA: em transiÃ§Ãµes
  79:     // overlayâ†’overlay (O1â†’O3) o botÃ£o de origem desmonta com o slot â€”
  80:     // o foco deve voltar ao trigger ORIGINAL (ex.: hambÃºrguer) no close.
  81:     if (activeRef.current === null) {
  82:       triggerRef.current =
  83:         document.activeElement instanceof HTMLElement
  84:           ? document.activeElement
  85:           : null;
  86:     }
  87:     setActive(id);
  88:   }, []);
  89: 
  90:   const close = useCallback(() => {
  91:     setActive(null);
  92:   }, []);
  93: 
  94:   // Esc fecha Â· trap de Tab Â· foco inicial Â· scroll lock Â· foco de volta.
  95:   useEffect(() => {
  96:     if (active === null) {
  97:       document.documentElement.removeAttribute("data-overlay");
  98:       const trigger = triggerRef.current;
  99:       if (trigger !== null) {
 100:         triggerRef.current = null;
 101:         trigger.focus();
 102:       }
 103:       return;
 104:     }
 105: 
 106:     document.documentElement.setAttribute("data-overlay", active);
 107:     const panel = panelRef.current;
 108:     const first = panel?.querySelector<HTMLElement>(FOCUSABLE);
 109:     (first ?? panel)?.focus();
 110: 
 111:     const onKeyDown = (e: KeyboardEvent) => {
 112:       if (e.key === "Escape") {
 113:         e.preventDefault();
 114:         setActive(null);
 115:         return;
 116:       }
 117:       if (e.key !== "Tab" || panel === null) return;
 118:       const nodes = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE));
 119:       if (nodes.length === 0) return;
 120:       const firstNode = nodes[0];
 121:       const lastNode = nodes[nodes.length - 1];
 122:       const current = document.activeElement;
 123:       if (e.shiftKey && (current === firstNode || current === panel)) {
 124:         e.preventDefault();
 125:         lastNode.focus();
 126:       } else if (!e.shiftKey && current === lastNode) {
 127:         e.preventDefault();
 128:         firstNode.focus();
 129:       }
 130:     };
 131: 
 132:     document.addEventListener("keydown", onKeyDown);
 133:     return () => {
 134:       document.removeEventListener("keydown", onKeyDown);
 135:     };
 136:   }, [active]);
 137: 
 138:   const value = useMemo<OverlayContextValue>(
 139:     () => ({ active, open, close }),
 140:     [active, open, close],
 141:   );
 142: 
 143:   return (
 144:     <OverlayContext.Provider value={value}>
 145:       {children}
 146:       {active !== null ? (
 147:         <div
 148:           ref={panelRef}
 149:           role="dialog"
 150:           aria-modal="true"
 151:           tabIndex={-1}
 152:           data-overlay-panel={active}
 153:           data-lenis-prevent
 154:         >
 155:           {active === "menu" ? menu : null}
 156:           {active === "contact" ? contact : null}
 157:           {active === "language" ? language : null}
 158:         </div>
 159:       ) : null}
 160:     </OverlayContext.Provider>
 161:   );
 162: }
