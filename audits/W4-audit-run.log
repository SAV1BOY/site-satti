### app\actions\submit-brief.ts
1: "use server";
2: 
3: import { headers } from "next/headers";
4: import { z } from "zod";
5: import { Resend } from "resend";
6: 
7: /**
8:  * submitBrief â€” Server Action do form de contato (S11 Â· ULTRAGOAL Â§6-W4).
9:  *
10:  * Pipeline: honeypot â†’ rate-limit por IP â†’ Zod â†’ Resend (e-mail) â†’
11:  * POST webhook n8n (â†’ Evolution API â†’ WhatsApp). Env ausente NUNCA
12:  * bloqueia (ApÃªndice B): canal indisponÃ­vel Ã© pulado com log claro;
13:  * se NENHUM canal entregar, o lead Ã© logado no server (Vercel logs) e
14:  * o form mostra a mensagem de erro OFICIAL do JSON (que jÃ¡ aponta o
15:  * mailto contato@sattiai.com como saÃ­da).
16:  *
17:  * O retorno Ã© apenas um status tipado â€” as strings visÃ­veis sÃ£o
18:  * resolvidas no client a partir de content/home.*.json (copy-law L1).
19:  */
20: 
21: export interface SubmitBriefState {
22:   status: "idle" | "success" | "error" | "invalid";
23:   /** Campos reprovados na validaÃ§Ã£o (para marcar .isError por campo). */
24:   fieldErrors?: Partial<Record<"name" | "email" | "message", string>>;
25: }
26: 
27: const BriefSchema = z.object({
28:   name: z.string().trim().min(2).max(200),
29:   email: z.string().trim().email().max(320),
30:   company: z.string().trim().max(200).optional().or(z.literal("")),
31:   message: z.string().trim().min(10).max(5000),
32:   budget: z.string().trim().max(120).optional().or(z.literal("")),
33: });
34: 
35: /* Rate-limit simples por IP (melhor esforÃ§o em serverless: vale por
36:    instÃ¢ncia quente â€” suficiente contra spam casual; Â§6-W4). */
37: const WINDOW_MS = 60 * 60 * 1000;
38: const MAX_PER_WINDOW = 5;
39: const hits = new Map<string, number[]>();
40: 
41: function rateLimited(ip: string): boolean {
42:   const now = Date.now();
43:   const recent = (hits.get(ip) ?? []).filter((t) => now - t < WINDOW_MS);
44:   recent.push(now);
45:   hits.set(ip, recent);
46:   return recent.length > MAX_PER_WINDOW;
47: }
48: 
49: export async function submitBrief(
50:   _prev: SubmitBriefState,
51:   formData: FormData,
52: ): Promise<SubmitBriefState> {
53:   // Honeypot: campo invisÃ­vel "website" â€” bot preenche, humano nÃ£o.
54:   if (String(formData.get("website") ?? "") !== "") {
55:     return { status: "success" }; // silÃªncio proposital para o bot
56:   }
57: 
58:   const hdrs = await headers();
59:   const ip =
60:     hdrs.get("x-forwarded-for")?.split(",")[0]?.trim() ?? "desconhecido";
61:   if (rateLimited(ip)) {
62:     return { status: "error" };
63:   }
64: 
65:   const parsed = BriefSchema.safeParse({
66:     name: formData.get("name"),
67:     email: formData.get("email"),
68:     company: formData.get("company"),
69:     message: formData.get("message"),
70:     budget: formData.get("budget"),
71:   });
72: 
73:   if (!parsed.success) {
74:     const fieldErrors: SubmitBriefState["fieldErrors"] = {};
75:     for (const issue of parsed.error.issues) {
76:       const field = issue.path[0];
77:       if (field === "name" || field === "email" || field === "message") {
78:         fieldErrors[field] = issue.code;
79:       }
80:     }
81:     return { status: "invalid", fieldErrors };
82:   }
83: 
84:   const brief = parsed.data;
85:   let delivered = false;
86: 
87:   // Canal 1 â€” e-mail via Resend
88:   const resendKey = process.env.RESEND_API_KEY;
89:   const from = process.env.CONTACT_FROM_EMAIL;
90:   const to = process.env.CONTACT_TO_EMAIL;
91:   if (resendKey && from && to) {
92:     try {
93:       const resend = new Resend(resendKey);
94:       const { error } = await resend.emails.send({
95:         from,
96:         to,
97:         replyTo: brief.email,
98:         subject: `[sattiai.com] Novo brief â€” ${brief.name}`,
99:         text: [
100:           `Nome: ${brief.name}`,
101:           `E-mail: ${brief.email}`,
102:           brief.company ? `Empresa: ${brief.company}` : null,
103:           brief.budget ? `Faixa de investimento: ${brief.budget}` : null,
104:           "",
105:           brief.message,
106:         ]
107:           .filter((line): line is string => line !== null)
108:           .join("\n"),
109:       });
110:       if (error) {
111:         console.error("[submitBrief] Resend falhou:", error);
112:       } else {
113:         delivered = true;
114:       }
115:     } catch (err) {
116:       console.error("[submitBrief] Resend exception:", err);
117:     }
118:   } else {
119:     console.warn(
120:       "[submitBrief] Resend nÃ£o configurado (RESEND_API_KEY/CONTACT_*_EMAIL) â€” canal pulado.",
121:     );
122:   }
123: 
124:   // Canal 2 â€” webhook n8n (â†’ Evolution API â†’ WhatsApp)
125:   const webhook = process.env.N8N_LEAD_WEBHOOK_URL;
126:   if (webhook) {
127:     try {
128:       const res = await fetch(webhook, {
129:         method: "POST",
130:         headers: { "Content-Type": "application/json" },
131:         body: JSON.stringify({
132:           source: "sattiai.com",
133:           ...brief,
134:           receivedAt: new Date().toISOString(),
135:         }),
136:       });
137:       if (res.ok) {
138:         delivered = true;
139:       } else {
140:         console.error(`[submitBrief] n8n webhook HTTP ${res.status}`);
141:       }
142:     } catch (err) {
143:       console.error("[submitBrief] n8n webhook exception:", err);
144:     }
145:   } else {
146:     console.warn(
147:       "[submitBrief] N8N_LEAD_WEBHOOK_URL nÃ£o configurada â€” canal pulado.",
148:     );
149:   }
150: 
151:   if (!delivered) {
152:     // Nenhum canal entregou: registrar o lead nos logs do server para
153:     // nÃ£o perder o contato (ApÃªndice B) e devolver o erro oficial.
154:     console.error(
155:       "[submitBrief] LEAD NÃƒO ENTREGUE â€” registro de contingÃªncia:",
156:       JSON.stringify({ ...brief, ip }),
157:     );
158:     return { status: "error" };
159:   }
160: 
161:   return { status: "success" };
162: }
