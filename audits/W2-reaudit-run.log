   3: 
   4: /**
   5:  * PulseCircle â€” diagrama circular do mÃ©todo SATTI (S5 Sobre).
   6:  *
   7:  * SVG quadrado responsivo (viewBox 560Ã—560) com 3 anÃ©is concÃªntricos
   8:  * nos raios 100% / 68% / 42% (200/136/84 na comp), 10 nodes distribuÃ­dos
   9:  * 5+3+2 com offset angular de 24Â° por anel, linhas de conexÃ£o radiais e
  10:  * labels mono uppercase.
  11:  *
  12:  * Server Component (sem "use client"): geometria calculada em mÃ³dulo,
  13:  * animaÃ§Ã£o 100% CSS.
  14:  *
  15:  * Leis:
  16:  * - L3: circuit apenas nas linhas/hub do diagrama (uso funcional permitido).
  17:  * - L5: pulso declarado somente dentro de
  18:  *   @media (prefers-reduced-motion: no-preference); fallback estÃ¡tico =
  19:  *   diagrama 100% desenhado, nodes opacos, sem animaÃ§Ã£o.
  20:  * - L10: pulso anima apenas opacity/transform (scale), 2s alternate,
  21:  *   delay 0.15s Ã— Ã­ndice via custom property.
  22:  *
  23:  * ReferÃªncia visual: S5 Sobre Desktop 1920.dc.html (funÃ§Ã£o _diagram).
  24:  */
  25: 
  26: const VIEWBOX = 560;
  27: const CENTER = 280;
  28: 
  29: /** Raios dos anÃ©is: 100% / 68% / 42% do raio externo (200px na comp). */
  30: const RINGS = [200, 136, 84] as const;
  31: 
  32: /** DistÃ¢ncia radial extra do label em relaÃ§Ã£o ao node (comp: r + 22). */
  33: const LABEL_OFFSET = 22;
  34: 
  35: /** Raio do node e do hub central (comp: 5 e 4). */
  36: const NODE_RADIUS = 5;
  37: const HUB_RADIUS = 4;
  38: 
  39: /** DistribuiÃ§Ã£o dos 10 nodes pelos anÃ©is (comp: 5 externo, 3 mÃ©dio, 2 interno). */
  40: const LAYOUT: ReadonlyArray<{ ring: 0 | 1 | 2; count: number }> = [
  41:   { ring: 0, count: 5 },
  42:   { ring: 1, count: 3 },
  43:   { ring: 2, count: 2 },
  44: ];
  45: 
  46: /** Labels EXATOS da comp S5 (array `labels` da funÃ§Ã£o _diagram). */
  47: const LABELS: ReadonlyArray<string> = [
  48:   "DISCOVERY",
  49:   "DADOS",
  50:   "AGENTES",
  51:   "AUTOMAÃ‡ÃƒO",
  52:   "PRODUTO",
  53:   "INTEGRAÃ‡Ã•ES",
  54:   "MÃ‰TRICAS",
  55:   "ITERAÃ‡ÃƒO",
  56:   "DEPLOY",
  57:   "SUPORTE",
  58: ];
  59: 
  60: interface DiagramNode {
  61:   x: number;
  62:   y: number;
  63:   labelX: number;
  64:   labelY: number;
  65:   anchor: "start" | "middle" | "end";
  66:   label: string;
  67: }
  68: 
  69: const round = (n: number): number => Math.round(n * 100) / 100;
  70: 
  71: function buildNodes(): ReadonlyArray<DiagramNode> {
  72:   const nodes: DiagramNode[] = [];
  73:   let index = 0;
  74: 
  75:   for (const group of LAYOUT) {
  76:     const radius = RINGS[group.ring];
  77: 
  78:     for (let k = 0; k < group.count; k++) {
  79:       // Mesma fÃ³rmula da comp: -90Â° inicial + passo uniforme + 24Â° Ã— anel.
  80:       const degrees = -90 + (360 / group.count) * k + group.ring * 24;
  81:       const angle = (degrees * Math.PI) / 180;
  82:       const cos = Math.cos(angle);
  83:       const sin = Math.sin(angle);
  84:       const anchor = cos > 0.2 ? "start" : cos < -0.2 ? "end" : "middle";
  85: 
  86:       nodes.push({
  87:         x: round(CENTER + radius * cos),
  88:         y: round(CENTER + radius * sin),
  89:         labelX: round(CENTER + (radius + LABEL_OFFSET) * cos),
  90:         labelY: round(CENTER + (radius + LABEL_OFFSET) * sin + 4),
  91:         anchor,
  92:         label: LABELS[index] ?? "",
  93:       });
  94:       index++;
  95:     }
  96:   }
  97: 
  98:   return nodes;
  99: }
 100: 
 101: const NODES = buildNodes();
 102: 
 103: type NodeStyle = CSSProperties & {
 104:   "--pulse-delay": string;
 105: };
 106: 
 107: interface PulseCircleProps {
 108:   /** Classe extra no svg (dimensÃ£o/posiÃ§Ã£o ficam por conta da seÃ§Ã£o). */
 109:   className?: string;
 110:   /** RÃ³tulo acessÃ­vel â€” OBRIGATÃ“RIO e vindo do JSON (copy-law L1:
 111:       nenhum literal editorial default no componente). */
 112:   ariaLabel: string;
 113: }
 114: 
 115: export default function PulseCircle({
 116:   className,
 117:   ariaLabel,
 118: }: PulseCircleProps) {
 119:   return (
 120:     <svg
 121:       viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
 122:       role="img"
 123:       aria-label={ariaLabel}
 124:       className={className ? `${styles.diagram} ${className}` : styles.diagram}
 125:     >
 126:       {RINGS.map((radius) => (
 127:         <circle
 128:           key={`ring-${radius}`}
 129:           cx={CENTER}
 130:           cy={CENTER}
 131:           r={radius}
 132:           className={styles.ring}
 133:         />
 134:       ))}
 135: 
 136:       {NODES.map((node) => (
 137:         <line
 138:           key={`spoke-${node.label}`}
 139:           x1={CENTER}
 140:           y1={CENTER}
 141:           x2={node.x}
 142:           y2={node.y}
 143:           className={styles.spoke}
 144:         />
 145:       ))}
 146: 
 147:       <circle cx={CENTER} cy={CENTER} r={HUB_RADIUS} className={styles.hub} />
 148: 
 149:       {NODES.map((node, index) => {
 150:         const style: NodeStyle = { "--pulse-delay": `${round(index * 0.15)}s` };
 151:         return (
 152:           <circle
 153:             key={`node-${node.label}`}
 154:             cx={node.x}
 155:             cy={node.y}
 156:             r={NODE_RADIUS}
 157:             className={styles.node}
 158:             style={style}
 159:           />
 160:         );
 161:       })}
 162: 
 163:       {NODES.map((node) => (
 164:         <text
 165:           key={`label-${node.label}`}
 166:           x={node.labelX}
 167:           y={node.labelY}
 168:           textAnchor={node.anchor}
 169:           className={styles.label}
 170:         >
 171:           {node.label}
 172:         </text>
 173:       ))}
 174:     </svg>
 175:   );
 176: }

