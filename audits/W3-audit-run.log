  58:   /** Labels mono dos nodes, por slot do plano (ex.: {n1: "TRIGGER"}). */
  59:   nodeLabels?: Partial<Record<string, string>>;
  60:   className?: string;
  61: }
  62: 
  63: interface Measured {
  64:   width: number;
  65:   height: number;
  66:   d: string;
  67:   length: number;
  68:   points: ReadonlyArray<{ wp: ThreadWaypoint; x: number; y: number }>;
  69: }
  70: 
  71: /** Cubics com tangente vertical entre waypoints consecutivos. */
  72: function buildPath(
  73:   waypoints: ReadonlyArray<ThreadWaypoint>,
  74:   w: number,
  75:   h: number,
  76: ): { d: string; points: Measured["points"] } {
  77:   const px = waypoints.map((wp) => ({
  78:     wp,
  79:     x: Math.round(wp.x * w * 100) / 100,
  80:     y: Math.round(wp.y * h * 100) / 100,
  81:   }));
  82: 
  83:   let d = "";
  84:   px.forEach((p, i) => {
  85:     if (i === 0) {
  86:       d = `M ${p.x} ${p.y}`;
  87:       return;
  88:     }
  89:     const prev = px[i - 1];
  90:     const dy = p.y - prev.y;
  91:     // Controles verticais: curva entra/sai reta no eixo Y (costura D3).
  92:     const k = Math.min(Math.max(dy * 0.45, 32), 260);
  93:     d += ` C ${prev.x} ${prev.y + k}, ${p.x} ${p.y - k}, ${p.x} ${p.y}`;
  94:   });
  95: 
  96:   return { d, points: px };
  97: }
  98: 
  99: export default function AutomationLine({
 100:   zone,
 101:   tone = "light",
 102:   nodeLabels,
 103:   className,
 104: }: AutomationLineProps) {
 105:   const plan = useMemo(() => getSegmentPlan(zone), [zone]);
 106:   const { pulseOwner, advancePulse, register, unregister, motionOk } =
 107:     useAutomationThread();
 108: 
 109:   const rootRef = useRef<HTMLDivElement | null>(null);
 110:   const pathRef = useRef<SVGPathElement | null>(null);
 111:   const nodesRef = useRef<SVGGElement | null>(null);
 112:   const [measured, setMeasured] = useState<Measured | null>(null);
 113: 
 114:   // Registro no fio (dono do pulso Ã© decidido pelo Thread).
 115:   useEffect(() => {
 116:     register(zone);
 117:     return () => {
 118:       unregister(zone);
 119:     };
 120:   }, [zone, register, unregister]);
 121: 
 122:   // Mede o container e (re)constrÃ³i o path em px reais.
 123:   useEffect(() => {
 124:     const root = rootRef.current;
 125:     if (!root) return;
 126: 
 127:     const measure = () => {
 128:       const w = root.clientWidth;
 129:       const h = root.clientHeight;
 130:       if (w === 0 || h === 0) return;
 131:       const { d, points } = buildPath(plan.waypoints, w, h);
 132:       setMeasured((prev) => {
 133:         if (prev && prev.d === d) return prev;
 134:         return { width: w, height: h, d, length: 0, points };
 135:       });
 136:     };
 137: 
 138:     measure();
 139:     const ro = new ResizeObserver(measure);
 140:     ro.observe(root);
 141:     return () => {
 142:       ro.disconnect();
 143:     };
 144:   }, [plan]);
 145: 
 146:   // Comprimento real do path (apÃ³s o d entrar no DOM).
 147:   useEffect(() => {
 148:     const path = pathRef.current;
 149:     if (!path || !measured || measured.length !== 0) return;
 150:     const length = path.getTotalLength();
 151:     setMeasured((prev) =>
 152:       prev && prev.d === measured.d ? { ...prev, length } : prev,
 153:     );
 154:   }, [measured]);
 155: 
 156:   // Desenho no scroll: IO liga/desliga rAF; rAF lÃª rect e escreve
 157:   // dashoffset + opacity dos nodes (L10: transform/opacity/stroke-offset).
 158:   useEffect(() => {
 159:     const root = rootRef.current;
 160:     const path = pathRef.current;
 161:     if (!root || !path || !measured || measured.length === 0) return;
 162: 
 163:     const len = measured.length;
 164: 
 165:     if (!motionOk) {
 166:       // L5: linha 100% desenhada, nodes visÃ­veis, nada anima.
 167:       path.style.strokeDasharray = "";
 168:       path.style.strokeDashoffset = "";
 169:       nodesRef.current
 170:         ?.querySelectorAll<SVGGElement>(`.${styles.nodeGroup}`)
 171:         .forEach((g) => {
 172:           g.style.opacity = "";
 173:         });
 174:       return;
 175:     }
 176: 
 177:     path.style.strokeDasharray = `${len}`;
 178:     path.style.strokeDashoffset = `${len}`;
 179: 
 180:     let raf = 0;
 181:     let lastOffset = -1;
 182: 
 183:     const frame = () => {
 184:       const rect = root.getBoundingClientRect();
 185:       const vh = window.innerHeight;
 186:       const progress = Math.min(
 187:         1,
 188:         Math.max(0, (vh * TIP_VH - rect.top) / rect.height),
 189:       );
 190:       const offset = Math.round(len * (1 - progress) * 10) / 10;
 191:       if (offset !== lastOffset) {
 192:         lastOffset = offset;
 193:         path.style.strokeDashoffset = `${offset}`;
 194:         // Node aparece quando o tip passa pelo seu y (path monotÃ´nico em y).
 195:         nodesRef.current
 196:           ?.querySelectorAll<SVGGElement>(`.${styles.nodeGroup}`)
 197:           .forEach((g) => {
 198:             const at = Number(g.dataset.at ?? "0");
 199:             g.style.opacity = progress >= at ? "1" : "0";
 200:           });
 201:       }
 202:       raf = requestAnimationFrame(frame);
 203:     };
 204: 
 205:     const io = new IntersectionObserver(
 206:       (entries) => {
 207:         const entry = entries[entries.length - 1];
 208:         if (!entry) return;
 209:         cancelAnimationFrame(raf);
 210:         if (entry.isIntersecting) {
 211:           raf = requestAnimationFrame(frame);
 212:         }
 213:       },
 214:       { rootMargin: "15% 0px 15% 0px" },
 215:     );
 216:     io.observe(root);
 217: 
 218:     return () => {
 219:       io.disconnect();
 220:       cancelAnimationFrame(raf);
 221:       path.style.strokeDasharray = "";
 222:       path.style.strokeDashoffset = "";
 223:     };
 224:   }, [measured, motionOk]);
 225: 
 226:   const handlePulseEnd = useCallback(() => {
 227:     advancePulse(zone);
 228:   }, [advancePulse, zone]);
 229: 
 230:   const ready = measured !== null && measured.length > 0;
 231:   const ownsPulse = ready && motionOk && pulseOwner === zone;
 232: 
 233:   const pulseStyle: PulseStyle | undefined =
 234:     ownsPulse && measured
 235:       ? {
 236:           offsetPath: `path("${measured.d}")`,
 237:           "--pulse-duration": `${Math.max(measured.length / PULSE_SPEED, 2)}s`,
 238:         }
 239:       : undefined;
 240: 
 241:   return (
 242:     <div
 243:       ref={rootRef}
 244:       className={[styles.root, styles[tone], className]
 245:         .filter(Boolean)
 246:         .join(" ")}
 247:       aria-hidden="true"
 248:     >
 249:       {measured ? (
 250:         <svg
 251:           className={styles.svg}
 252:           data-ready={ready ? "true" : undefined}
 253:           viewBox={`0 0 ${measured.width} ${measured.height}`}
 254:           preserveAspectRatio="none"
 255:         >
 256:           <path ref={pathRef} className={styles.path} d={measured.d} />
 257: 
 258:           <g ref={nodesRef}>
 259:             {measured.points
 260:               .filter((p) => p.wp.slot !== undefined)
 261:               .map((p) => {
 262:                 const slot = p.wp.slot as string;
 263:                 const label = nodeLabels?.[slot];
 264:                 const anchorStart = p.wp.x <= 0.6;
 265:                 return (
 266:                   <g
 267:                     key={slot}
 268:                     className={styles.nodeGroup}
 269:                     data-at={p.wp.y}
 270:                   >
 271:                     <circle
 272:                       className={styles.node}
 273:                       cx={p.x}
 274:                       cy={p.y}
 275:                       r={NODE_R}
 276:                     />
 277:                     {label ? (
 278:                       <text
 279:                         className={styles.nodeLabel}
 280:                         x={anchorStart ? p.x + 14 : p.x - 14}
 281:                         y={p.y + 4}
 282:                         textAnchor={anchorStart ? "start" : "end"}
 283:                       >
 284:                         {label}
 285:                       </text>
 286:                     ) : null}
 287:                   </g>
 288:                 );
 289:               })}
 290:           </g>
 291: 
 292:           {ownsPulse ? (
 293:             <circle
 294:               className={`${styles.pulse} ${styles.pulseRun}`}
 295:               r={PULSE_R}
 296:               style={pulseStyle}
 297:               onAnimationEnd={handlePulseEnd}
 298:             />
 299:           ) : null}
 300:         </svg>
 301:       ) : null}
 302:     </div>
 303:   );
 304: }
