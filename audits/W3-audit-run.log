   5: import styles from "./StickyHeader.module.css";
   6: 
   7: /**
   8:  * HeaderClient â€” comportamento do pill (comp S1+S2 + decisÃ£o F0-F5):
   9:  * - Estado base (sobre o hero): CTA "Falar com a SATTI" ghost/hairline.
  10:  * - Aos ~80% da altura da viewport (fim do hero) o header ativa e o CTA
  11:  *   preenche blaze â€” transiÃ§Ã£o .4s var(--ease), texto iron sobre blaze (L2).
  12:  * - Scroll: listener passive + rAF-throttle (padrÃ£o sancionado pela L10).
  13:  * - CTA com roll de texto (duas camadas, --ease-roll â€” comp: 0.35s).
  14:  * - Menu hambÃºrguer: abre O1 no W4; por ora aria-expanded=false + handler.
  15:  * - Reduced-motion: sem transiÃ§Ã£o de preenchimento nem roll (sÃ³ troca).
  16:  */
  17: 
  18: interface NavItem {
  19:   label: string;
  20:   href: string;
  21: }
  22: 
  23: interface HeaderClientProps {
  24:   brand: string;
  25:   nav: NavItem[];
  26:   cta: string;
  27:   menuLabel: string;
  28:   localePt: string;
  29:   localeSeparator: string;
  30:   localeEn: string;
  31:   currentLocale: string;
  32:   onMenuOpen?: () => void;
  33: }
  34: 
  35: export default function HeaderClient({
  36:   brand,
  37:   nav,
  38:   cta,
  39:   menuLabel,
  40:   localePt,
  41:   localeSeparator,
  42:   localeEn,
  43:   currentLocale,
  44:   onMenuOpen,
  45: }: HeaderClientProps) {
  46:   const [active, setActive] = useState(false);
  47: 
  48:   useEffect(() => {
  49:     let raf = 0;
  50:     const update = () => {
  51:       setActive(window.scrollY >= window.innerHeight * 0.8);
  52:       raf = 0;
  53:     };
  54:     const onScroll = () => {
  55:       if (raf === 0) raf = requestAnimationFrame(update);
  56:     };
  57:     update();
  58:     window.addEventListener("scroll", onScroll, { passive: true });
  59:     window.addEventListener("resize", onScroll, { passive: true });
  60:     return () => {
  61:       window.removeEventListener("scroll", onScroll);
  62:       window.removeEventListener("resize", onScroll);
  63:       cancelAnimationFrame(raf);
  64:     };
  65:   }, []);
  66: 
  67:   const isPt = currentLocale !== "en";
  68: 
  69:   return (
  70:     <header className={styles.header} data-active={active ? "true" : "false"}>
  71:       <a className={styles.brand} href="#top">
  72:         {brand}
  73:       </a>
  74: 
  75:       <nav className={styles.nav}>
  76:         {nav.map((item) => (
  77:           <a key={item.href} className={styles.navLink} href={item.href}>
  78:             {item.label}
  79:           </a>
  80:         ))}
  81:       </nav>
  82: 
  83:       <div className={styles.actions}>
  84:         <span className={styles.locale}>
  85:           <Link
  86:             href="/"
  87:             className={isPt ? styles.localeActive : styles.localeLink}
  88:             aria-current={isPt ? "true" : undefined}
  89:           >
  90:             {localePt}
  91:           </Link>
  92:           <span aria-hidden="true">{localeSeparator}</span>
  93:           <Link
  94:             href="/en"
  95:             className={!isPt ? styles.localeActive : styles.localeLink}
  96:             aria-current={!isPt ? "true" : undefined}
  97:           >
  98:             {localeEn}
  99:           </Link>
 100:         </span>
 101: 
 102:         <a className={styles.cta} href="#contato" data-cursor="hover">
 103:           <span className={styles.ctaMask}>
 104:             <span className={styles.ctaLabel}>{cta}</span>
 105:             <span className={styles.ctaLabel} aria-hidden="true">
 106:               {cta}
 107:             </span>
 108:           </span>
 109:         </a>
 110: 
 111:         <button
 112:           className={styles.menu}
 113:           type="button"
 114:           aria-label={menuLabel}
 115:           aria-expanded={false}
 116:           onClick={() => onMenuOpen?.()}
 117:         >
 118:           <span />
 119:           <span />
