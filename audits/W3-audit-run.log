### components\sections\footer\FooterHat.tsx
   1: "use client";
   2: 
   3: import { useEffect, useRef } from "react";
   4: import { useMotionOk } from "@/hooks/useMotionOk";
   5: import styles from "./Footer.module.css";
   6: 
   7: /**
   8:  * FooterHat â€” wordmark gigante decorativo com parallax sutil
   9:  * (Atlas: "footer parallax hat").
  10:  *
  11:  * Client island mÃ­nima (L11): o Footer Ã© Server Component; aqui mora
  12:  * SÃ“ o efeito. Parallax: IntersectionObserver liga/desliga um loop rAF
  13:  * que lÃª o rect do wrapper e escreve translate3d(0, y%, 0) no inner â€”
  14:  * transform-only (L10), mapeamento linear do progresso de scroll (sem
  15:  * tween; o easing Ã© o do prÃ³prio dedo/roda).
  16:  * L5: gated por useMotionOk â€” reduced-motion e SSR/primeiro paint =
  17:  * estÃ¡tico (estado das comps), transform limpo.
  18:  * A11y: puramente decorativo â€” wrapper aria-hidden (a marca legÃ­vel Ã©
  19:  * a da coluna do footer).
  20:  */
  21: 
  22: /** Curso do parallax em % da prÃ³pria altura do hat (sutil). */
  23: const HAT_FROM = 12;
  24: const HAT_TO = -6;
  25: 
  26: interface FooterHatProps {
  27:   /** Wordmark (footer.brand via next-intl no pai â€” copy nunca hardcoded, L1). */
  28:   text: string;
  29: }
  30: 
  31: export default function FooterHat({ text }: FooterHatProps) {
  32:   const rootRef = useRef<HTMLDivElement | null>(null);
  33:   const innerRef = useRef<HTMLSpanElement | null>(null);
  34:   const motionOk = useMotionOk();
  35: 
  36:   useEffect(() => {
  37:     const root = rootRef.current;
  38:     const inner = innerRef.current;
  39:     if (!root || !inner || !motionOk) return;
  40: 
  41:     let raf = 0;
  42:     let lastY = Number.NaN;
  43: 
  44:     const frame = () => {
  45:       const rect = root.getBoundingClientRect();
  46:       const vh = window.innerHeight;
  47:       // 0 â†’ topo do hat entrando pela base da viewport Â· 1 â†’ base saindo
  48:       // pelo topo (o footer Ã© a Ãºltima dobra: fica num trecho parcial).
  49:       const progress = Math.min(
  50:         1,
  51:         Math.max(0, (vh - rect.top) / (vh + rect.height)),
  52:       );
  53:       const y =
  54:         Math.round((HAT_FROM + (HAT_TO - HAT_FROM) * progress) * 100) / 100;
  55:       if (y !== lastY) {
  56:         lastY = y;
  57:         inner.style.transform = `translate3d(0, ${y}%, 0)`;
  58:       }
  59:       raf = requestAnimationFrame(frame);
  60:     };
  61: 
  62:     const io = new IntersectionObserver((entries) => {
  63:       const entry = entries[entries.length - 1];
  64:       if (!entry) return;
  65:       cancelAnimationFrame(raf);
  66:       if (entry.isIntersecting) {
  67:         raf = requestAnimationFrame(frame);
  68:       }
  69:     });
  70:     io.observe(root);
  71: 
  72:     return () => {
  73:       io.disconnect();
  74:       cancelAnimationFrame(raf);
  75:       inner.style.transform = "";
  76:     };
  77:   }, [motionOk]);
  78: 
  79:   return (
  80:     <div ref={rootRef} className={styles.hat} aria-hidden="true">
  81:       <span ref={innerRef} className={styles.hatInner}>
  82:         {text}
  83:       </span>
  84:     </div>
  85:   );
  86: }
