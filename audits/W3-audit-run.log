   1: import type { CSSProperties } from "react";
   2: import styles from "./PulseCircle.module.css";
   3: 
   4: /**
   5:  * PulseCircle â€” diagrama circular do mÃ©todo SATTI (S5 Sobre).
   6:  *
   7:  * SVG quadrado responsivo (viewBox 560Ã—560) com 3 anÃ©is concÃªntricos
   8:  * nos raios 100% / 68% / 42% (200/136/84 na comp), 10 nodes distribuÃ­dos
   9:  * 5+3+2 com offset angular de 24Â° por anel, linhas de conexÃ£o radiais e
  10:  * labels mono uppercase.
  11:  *
  12:  * Server Component (sem "use client"): geometria calculada em mÃ³dulo,
  13:  * animaÃ§Ã£o 100% CSS.
  14:  *
  15:  * Leis:
  16:  * - L3: circuit apenas nas linhas/hub do diagrama (uso funcional permitido).
  17:  * - L5: pulso declarado somente dentro de
  18:  *   @media (prefers-reduced-motion: no-preference); fallback estÃ¡tico =
  19:  *   diagrama 100% desenhado, nodes opacos, sem animaÃ§Ã£o.
  20:  * - L10: pulso anima apenas opacity/transform (scale), 2s alternate,
  21:  *   delay 0.15s Ã— Ã­ndice via custom property.
  22:  *
  23:  * ReferÃªncia visual: S5 Sobre Desktop 1920.dc.html (funÃ§Ã£o _diagram).
  24:  */
  25: 
  26: const VIEWBOX = 560;
  27: const CENTER = 280;
  28: 
  29: /** Raios dos anÃ©is: 100% / 68% / 42% do raio externo (200px na comp). */
  30: const RINGS = [200, 136, 84] as const;
  31: 
  32: /** DistÃ¢ncia radial extra do label em relaÃ§Ã£o ao node (comp: r + 22). */
  33: const LABEL_OFFSET = 22;
  34: 
  35: /** Raio do node e do hub central (comp: 5 e 4). */
  36: const NODE_RADIUS = 5;
  37: const HUB_RADIUS = 4;
  38: 
  39: /** DistribuiÃ§Ã£o dos 10 nodes pelos anÃ©is (comp: 5 externo, 3 mÃ©dio, 2 interno). */
  40: const LAYOUT: ReadonlyArray<{ ring: 0 | 1 | 2; count: number }> = [
  41:   { ring: 0, count: 5 },
  42:   { ring: 1, count: 3 },
  43:   { ring: 2, count: 2 },
  44: ];
  45: 
  46: interface DiagramNode {
  47:   x: number;
  48:   y: number;
  49:   labelX: number;
  50:   labelY: number;
  51:   anchor: "start" | "middle" | "end";
  52: }
  53: 
  54: const round = (n: number): number => Math.round(n * 100) / 100;
  55: 
  56: function buildNodes(): ReadonlyArray<DiagramNode> {
  57:   const nodes: DiagramNode[] = [];
  58: 
  59:   for (const group of LAYOUT) {
  60:     const radius = RINGS[group.ring];
  61: 
  62:     for (let k = 0; k < group.count; k++) {
  63:       // Mesma fÃ³rmula da comp: -90Â° inicial + passo uniforme + 24Â° Ã— anel.
  64:       const degrees = -90 + (360 / group.count) * k + group.ring * 24;
  65:       const angle = (degrees * Math.PI) / 180;
  66:       const cos = Math.cos(angle);
  67:       const sin = Math.sin(angle);
  68:       const anchor = cos > 0.2 ? "start" : cos < -0.2 ? "end" : "middle";
  69: 
  70:       nodes.push({
  71:         x: round(CENTER + radius * cos),
  72:         y: round(CENTER + radius * sin),
  73:         labelX: round(CENTER + (radius + LABEL_OFFSET) * cos),
  74:         labelY: round(CENTER + (radius + LABEL_OFFSET) * sin + 4),
  75:         anchor,
  76:       });
  77:     }
  78:   }
  79: 
  80:   return nodes;
  81: }
  82: 
  83: const NODES = buildNodes();
  84: 
  85: type NodeStyle = CSSProperties & {
  86:   "--pulse-delay": string;
  87: };
  88: 
  89: interface PulseCircleProps {
  90:   /** Classe extra no svg (dimensÃ£o/posiÃ§Ã£o ficam por conta da seÃ§Ã£o). */
  91:   className?: string;
  92:   /** RÃ³tulo acessÃ­vel â€” OBRIGATÃ“RIO e vindo do JSON (copy-law L1:
  93:       nenhum literal editorial default no componente). */
  94:   ariaLabel: string;
  95:   /** Labels dos 10 nodes na ordem da comp â€” OBRIGATÃ“RIO e vindo do JSON
  96:       (about.methodNodes), garantindo o espelho /en 1:1 (D5/Â§7.12). */
  97:   labels: ReadonlyArray<string>;
  98: }
  99: 
 100: export default function PulseCircle({
 101:   className,
 102:   ariaLabel,
 103:   labels,
 104: }: PulseCircleProps) {
 105:   return (
 106:     <svg
 107:       viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
 108:       role="img"
 109:       aria-label={ariaLabel}
 110:       className={className ? `${styles.diagram} ${className}` : styles.diagram}
 111:     >
 112:       {RINGS.map((radius) => (
 113:         <circle
 114:           key={`ring-${radius}`}
 115:           cx={CENTER}
 116:           cy={CENTER}
 117:           r={radius}
 118:           className={styles.ring}
 119:         />
 120:       ))}
 121: 
 122:       {NODES.map((node, index) => (
 123:         <line
 124:           key={`spoke-${index}`}
 125:           x1={CENTER}
 126:           y1={CENTER}
 127:           x2={node.x}
 128:           y2={node.y}
 129:           className={styles.spoke}
 130:         />
 131:       ))}
 132: 
 133:       <circle cx={CENTER} cy={CENTER} r={HUB_RADIUS} className={styles.hub} />
 134: 
 135:       {NODES.map((node, index) => {
 136:         const style: NodeStyle = { "--pulse-delay": `${round(index * 0.15)}s` };
 137:         return (
 138:           <circle
 139:             key={`node-${index}`}
 140:             cx={node.x}
 141:             cy={node.y}
 142:             r={NODE_RADIUS}
 143:             className={styles.node}
 144:             style={style}
 145:           />
 146:         );
 147:       })}
 148: 
 149:       {NODES.map((node, index) => (
 150:         <text
 151:           key={`label-${index}`}
 152:           x={node.labelX}
 153:           y={node.labelY}
 154:           textAnchor={node.anchor}
 155:           className={styles.label}
 156:         >
 157:           {labels[index] ?? ""}
 158:         </text>
 159:       ))}
 160:     </svg>
 161:   );
 162: }
### components/ui/PulseCircle.module.css
   1: /* ============================================================
   2:    PulseCircle â€” diagrama circular do mÃ©todo SATTI (S5 Sobre)
   3:    Ref: S5 Sobre Desktop 1920.dc.html (_diagram)
   4: 
   5:    L3  â€” circuit somente em linhas/hub (diagrama = uso funcional)
   6:    L5  â€” pulso APENAS dentro de prefers-reduced-motion: no-preference;
   7:          fallback estÃ¡tico = nodes opacos, diagrama 100% desenhado
   8:    L10 â€” animaÃ§Ã£o sÃ³ opacity/transform (scale), 2s alternate,
   9:          delay 0.15s Ã— Ã­ndice via --pulse-delay
  10:    ============================================================ */
  11: 
  12: .diagram {
  13:   display: block;
  14:   inline-size: 100%;
  15:   block-size: auto;
  16:   aspect-ratio: 1;
  17: }
