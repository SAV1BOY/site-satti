  35: .hub {
  36:   fill: var(--c-circuit);
  37: }
  38: 
  39: /* Nodes â€” comp: fill circuit (diagrama funcional, L3).
  40:    Estado base = fallback estÃ¡tico (L5): opacos, sem animaÃ§Ã£o */
  41: .node {
  42:   fill: var(--c-circuit);
  43: }
  44: 
  45: /* Labels mono caption */
  46: .label {
