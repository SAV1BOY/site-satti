 107: /** Valida o contrato de continuidade (dev only â€” chamado pelo Thread). */
 108: export function validateThreadPlan(): string[] {
 109:   const issues: string[] = [];
 110:   const sorted = [...THREAD_PLAN].sort((a, b) => a.order - b.order);
 111: 
 112:   sorted.forEach((seg, i) => {
 113:     const first = seg.waypoints[0];
 114:     const last = seg.waypoints[seg.waypoints.length - 1];
 115:     if (!first || !last) {
 116:       issues.push(`${seg.id}: segmento sem waypoints`);
 117:       return;
 118:     }
 119:     if (i > 0 && first.y !== 0) {
 120:       issues.push(`${seg.id}: entrada deve estar em y=0 (estÃ¡ em ${first.y})`);
 121:     }
 122:     if (i < sorted.length - 1 && last.y !== 1) {
 123:       issues.push(`${seg.id}: saÃ­da deve estar em y=1 (estÃ¡ em ${last.y})`);
 124:     }
 125:     if (i > 0) {
 126:       const prev = sorted[i - 1];
 127:       const prevExit = prev.waypoints[prev.waypoints.length - 1];
 128:       if (prevExit && prevExit.x !== first.x) {
 129:         issues.push(
 130:           `handshake quebrado ${prev.id} â†’ ${seg.id}: saÃ­da x=${prevExit.x} â‰  entrada x=${first.x}`,
 131:         );
 132:       }
 133:     }
 134:   });
 135: 
 136:   return issues;
