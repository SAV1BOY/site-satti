   6: 
   7: /**
   8:  * ServicesDeck â€” coreografia "cards sobrepostos no scroll" da S4
   9:  * (Atlas 03 + spec Â§6-W3). Client child mÃ­nimo (L11): os cards chegam
  10:  * SERVER-RENDERED como children; aqui sÃ³ vive o efeito de scroll.
  11:  *
  12:  * Desktop (â‰¥1024px) com motion ok:
  13:  * - O deck vira um trilho de 220vh com stage sticky (CSS via
  14:  *   [data-active]); os cards 2 e 3 comeÃ§am EMPILHADOS sobre o card 1
  15:  *   com offset visÃ­vel de 40px entre eles ("stack com offset ~40px")
  16:  *   e deslizam para a fila final com sobreposiÃ§Ã£o -40px (comp) ao
  17:  *   longo do pin.
  18:  * - Progresso: IO liga/desliga rAF; o frame lÃª o rect do trilho e
  19:  *   escreve APENAS transform: translateX (L10) nos cards mÃ³veis.
  20:  *   Mapeamento linear com o scroll (scroll Ã© o easing â€” mesmo padrÃ£o
  21:  *   da AutomationLine); janelas escalonadas por card.
  22:  *
  23:  * Estado base (SSR / reduced-motion / <1024px): nenhum atributo,
  24:  * nenhum transform â€” fila final desktop / pilha vertical mobile,
  25:  * exatamente o estado estÃ¡tico das comps (L5).
  26:  */
  27: 
  28: const DESKTOP_MQ = "(min-width: 1024px)";
  29: 
  30: /** Offset visÃ­vel entre cartas no stack = sobreposiÃ§Ã£o final (comp). */
  31: const LIP = 40;
  32: 
  33: /** Janela [inÃ­cio, fim] do progresso do pin em que cada card mÃ³vel viaja. */
  34: const DEAL_WINDOWS: ReadonlyArray<readonly [number, number]> = [
  35:   [0, 0.6],
  36:   [0.35, 0.95],
  37: ];
  38: 
  39: export default function ServicesDeck({ children }: { children: ReactNode }) {
  40:   const motionOk = useMotionOk();
  41:   const [desktop, setDesktop] = useState(false);
  42:   const deckRef = useRef<HTMLDivElement | null>(null);
  43: 
  44:   useEffect(() => {
  45:     const mql = window.matchMedia(DESKTOP_MQ);
  46:     const sync = () => {
  47:       setDesktop(mql.matches);
  48:     };
  49:     sync();
  50:     mql.addEventListener("change", sync);
  51:     return () => {
  52:       mql.removeEventListener("change", sync);
  53:     };
  54:   }, []);
  55: 
  56:   const active = motionOk && desktop;
  57: 
  58:   useEffect(() => {
  59:     const deck = deckRef.current;
  60:     if (!deck || !active) return;
  61: 
  62:     const moving = Array.from(
  63:       deck.querySelectorAll<HTMLElement>("[data-deck-card]"),
  64:     ).slice(1);
  65:     if (moving.length === 0) return;
  66: 
  67:     let raf = 0;
  68:     let lastP = -1;
  69: 
  70:     const frame = () => {
  71:       const rect = deck.getBoundingClientRect();
  72:       const travel = rect.height - window.innerHeight;
  73:       const raw = travel > 0 ? -rect.top / travel : 1;
  74:       const p = Math.round(Math.min(1, Math.max(0, raw)) * 1000) / 1000;
  75: 
  76:       if (p !== lastP) {
  77:         lastP = p;
  78:         moving.forEach((card, i) => {
  79:           const win =
  80:             DEAL_WINDOWS[Math.min(i, DEAL_WINDOWS.length - 1)] ?? [0, 1];
  81:           const [a, b] = win;
  82:           const local =
  83:             b > a ? Math.min(1, Math.max(0, (p - a) / (b - a))) : 1;
  84: 
  85:           if (local >= 1) {
  86:             card.style.transform = "";
  87:             return;
  88:           }
  89:           // PosiÃ§Ã£o inicial: card i (1-based entre os mÃ³veis) empilhado
  90:           // Ã  esquerda com lip de 40px â†’ shift = -(i+1) Ã— (largura âˆ’ 80).
  91:           const width = card.getBoundingClientRect().width;
  92:           const shift = -(i + 1) * (width - 2 * LIP) * (1 - local);
  93:           card.style.transform = `translateX(${Math.round(shift * 10) / 10}px)`;
  94:         });
  95:       }
  96:       raf = requestAnimationFrame(frame);
  97:     };
  98: 
  99:     const io = new IntersectionObserver(
 100:       (entries) => {
 101:         const entry = entries[entries.length - 1];
 102:         if (!entry) return;
 103:         cancelAnimationFrame(raf);
 104:         if (entry.isIntersecting) {
 105:           raf = requestAnimationFrame(frame);
 106:         }
 107:       },
 108:       { rootMargin: "20% 0px 20% 0px" },
 109:     );
 110:     io.observe(deck);
 111: 
 112:     return () => {
 113:       io.disconnect();
 114:       cancelAnimationFrame(raf);
 115:       moving.forEach((card) => {
 116:         card.style.transform = "";
 117:       });
 118:     };
 119:   }, [active]);
 120: 
 121:   return (
 122:     <div
 123:       ref={deckRef}
 124:       className={styles.deck}
 125:       data-active={active ? "true" : undefined}
 126:     >
 127:       <div className={styles.stage}>
 128:         <div className={styles.row}>{children}</div>
 129:       </div>
 130:     </div>
 131:   );
 132: }
