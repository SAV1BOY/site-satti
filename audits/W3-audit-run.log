   6: /**
   7:  * HeroTypewriter â€” 3Âª linha do H1 (comp S1+S2): cicla as palavras
   8:  * OFICIAIS hero.words (VENDER Â· ATENDER Â· OPERAR Â· CRESCER) via
   9:  * hooks/useTypewriter (90ms/char Â· 1400ms hold Â· 45ms delete â€”
  10:  * defaults do hook = valores da comp).
  11:  *
  12:  * L1: as palavras chegam por props do server (JSON) â€” nada aqui.
  13:  * L2: o caret blaze Ã© O elemento blaze do viewport do hero (F0â€“F5);
  14:  *     blink steps(1) vive no CSS Module, gated por
  15:  *     prefers-reduced-motion: no-preference (L5).
  16:  * L5: reduced-motion/SSR â†’ o hook devolve a 1Âª palavra fixa
  17:  *     ("VENDER", comp), caret estÃ¡tico aceso.
  18:  * A11y: palavra atual no fluxo do h1 com aria-live="off" (nÃ£o
  19:  *     anuncia cada tecla); ghost reserva largura ("CRESCER" =
  20:  *     Ãºltima palavra) â†’ zero layout shift, escondido de AT.
  21:  */
  22: 
  23: export default function HeroTypewriter({ words }: { words: string[] }) {
  24:   const { text } = useTypewriter(words);
  25:   const ghost = words[words.length - 1] ?? "";
