  31: .light {
  32:   --al-stroke: var(--c-line);
  33:   --al-node-fill: var(--c-paper);
  34:   --al-node-stroke: var(--c-line);
  35:   --al-label: var(--c-steel);
  36: }
  37: 
  38: .dark {
  39:   --al-stroke: var(--c-line-dark);
