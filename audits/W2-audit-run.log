 122:           { text: first, wordIndex: 0, phase: "holding" }
 123:         : // Motion permitido: digita a primeira palavra do zero, como no comp.
 124:           { text: "", wordIndex: 0, phase: "typing" },
 125:     );
 126:   }
 127: 
 128:   // MÃ¡quina de estados com setTimeout ENCADEADO: cada transiÃ§Ã£o agenda a
 129:   // prÃ³xima, e o cleanup limpa o timer pendente (unmount, mudanÃ§a de deps,
 130:   // troca de preferÃªncia de motion).
