 247:       aria-hidden="true"
 248:     >
 249:       {measured ? (
 250:         <svg
 251:           className={styles.svg}
 252:           data-ready={ready ? "true" : undefined}
 253:           viewBox={`0 0 ${measured.width} ${measured.height}`}
 254:           preserveAspectRatio="none"
 255:         >
 256:           <path ref={pathRef} className={styles.path} d={measured.d} />
 257: 
 258:           <g ref={nodesRef}>
 259:             {measured.points
 260:               .filter((p) => p.wp.slot !== undefined)
 261:               .map((p) => {
 262:                 const slot = p.wp.slot as string;
 263:                 const label = nodeLabels?.[slot];
 264:                 const anchorStart = p.wp.x <= 0.6;
 265:                 return (
 266:                   <g
 267:                     key={slot}
 268:                     className={styles.nodeGroup}
 269:                     data-at={p.wp.y}
 270:                   >
 271:                     <circle
 272:                       className={styles.node}
 273:                       cx={p.x}
 274:                       cy={p.y}
 275:                       r={NODE_R}
 276:                     />
 277:                     {label ? (
 278:                       <text
 279:                         className={styles.nodeLabel}
 280:                         x={anchorStart ? p.x + 14 : p.x - 14}
 281:                         y={p.y + 4}
 282:                         textAnchor={anchorStart ? "start" : "end"}
 283:                       >
 284:                         {label}
 285:                       </text>
 286:                     ) : null}
 287:                   </g>
 288:                 );
 289:               })}
 290:           </g>
 291: 
 292:           {ownsPulse ? (
 293:             <circle
 294:               className={`${styles.pulse} ${styles.pulseRun}`}
 295:               r={PULSE_R}
 296:               style={pulseStyle}
 297:               onAnimationEnd={handlePulseEnd}
 298:             />
 299:           ) : null}
 300:         </svg>
 301:       ) : null}
 302:     </div>
 303:   );
 304: }
