 151:   const dataActive = isTouch && isPlaying ? "true" : undefined;
 152: 
 153:   const content = (
 154:     <>
 155:       <div className={styles.media}>
 156:         <Image
 157:           src={posterSrc}
 158:           alt=""
 159:           fill
 160:           sizes={POSTER_SIZES}
 161:           className={styles.poster}
 162:         />
 163:         {motionOk ? (
