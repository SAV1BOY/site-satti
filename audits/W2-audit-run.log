   1: "use client";
   2: 
   3: import { useEffect, useState } from "react";
   4: 
   5: /**
   6:  * useMotionOk â€” preferÃªncia de motion como estado React (L5).
   7:  *
   8:  * SSR/primeiro paint: `false` (conservador â€” nada anima antes da
   9:  * detecÃ§Ã£o, evitando flash de animaÃ§Ã£o para quem prefere reduzido).
  10:  * ApÃ³s o mount, sincroniza com `(prefers-reduced-motion: no-preference)`
  11:  * e acompanha mudanÃ§as ao vivo.
  12:  */
  13: export function useMotionOk(): boolean {
  14:   const [motionOk, setMotionOk] = useState(false);
  15: 
  16:   useEffect(() => {
  17:     const mql = window.matchMedia("(prefers-reduced-motion: no-preference)");
  18:     const sync = () => {
  19:       setMotionOk(mql.matches);
  20:     };
  21:     sync();
  22:     mql.addEventListener("change", sync);
  23:     return () => {
  24:       mql.removeEventListener("change", sync);
  25:     };
  26:   }, []);
  27: 
  28:   return motionOk;
  29: }
