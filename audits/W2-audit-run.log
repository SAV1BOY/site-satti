  12:  * L5 â€” fallback reduced-motion: com `prefers-reduced-motion: reduce` o hook
  13:  * devolve a PRIMEIRA palavra completa, estÃ¡tica, phase "holding", e NENHUM
  14:  * timer Ã© agendado. Esse mesmo estado Ã© o render de servidor / primeiro paint
  15:  * (sem flash de hero vazio antes da hidrataÃ§Ã£o).
  16:  *
  17:  * O hook nÃ£o renderiza nada â€” o caret (blaze, blink em steps(1)) Ã©
  18:  * responsabilidade do consumidor, que deve pausÃ¡-lo em reduced-motion.
  19:  *
  20:  * Uso de referÃªncia (hero): useTypewriter(["VENDER", "ATENDER", "OPERAR", "CRESCER"])
  21:  */
  22: 
  23: export type TypewriterPhase = "typing" | "holding" | "deleting";
  24: 
  25: export interface UseTypewriterOptions {
  26:   /** ms por caractere digitado. Default: 90 (comp). */
  27:   typeMs?: number;
  28:   /** ms por caractere apagado. Default: 45 (comp). */
  29:   deleteMs?: number;
  30:   /** ms segurando a palavra completa antes de apagar. Default: 1400 (comp). */
  31:   holdMs?: number;
  32: }
  33: 
  34: export interface UseTypewriterResult {
  35:   /** Texto parcial/completo da palavra atual. */
  36:   text: string;
  37:   /** Ãndice da palavra atual em `words`. */
  38:   wordIndex: number;
  39:   /** Fase atual do ciclo. Em reduced-motion Ã© sempre "holding". */
  40:   phase: TypewriterPhase;
  41: }
  42: 
  43: interface TypewriterState {
  44:   text: string;
  45:   wordIndex: number;
  46:   phase: TypewriterPhase;
  47: }
  48: 
  49: const DEFAULT_TYPE_MS = 90;
  50: const DEFAULT_DELETE_MS = 45;
  51: const DEFAULT_HOLD_MS = 1400;
  52: /** Pausa entre apagar a Ãºltima letra e comeÃ§ar a digitar a prÃ³xima palavra (comp: 240ms). */
  53: const WORD_GAP_MS = 240;
  54: 
  55: const REDUCED_QUERY = "(prefers-reduced-motion: reduce)";
  56: 
  57: function subscribeReducedMotion(onChange: () => void): () => void {
  58:   const mql = window.matchMedia(REDUCED_QUERY);
  59:   mql.addEventListener("change", onChange);
  60:   return () => {
  61:     mql.removeEventListener("change", onChange);
  62:   };
  63: }
  64: 
  65: const getReducedMotion = (): boolean => window.matchMedia(REDUCED_QUERY).matches;
  66: 
  67: /** Servidor/hidrataÃ§Ã£o: trata como reduced â†’ estado estÃ¡tico, sem timers (L5). */
  68: const getServerReducedMotion = (): boolean => true;
  69: /** Separador interno da chave de conteÃºdo (nunca ocorre em copy). */
  70: const KEY_SEPARATOR = "\u001F";
  71: 
  72: export function useTypewriter(
  73:   words: string[],
  74:   opts?: UseTypewriterOptions,
  75: ): UseTypewriterResult {
  76:   const typeMs = opts?.typeMs ?? DEFAULT_TYPE_MS;
  77:   const deleteMs = opts?.deleteMs ?? DEFAULT_DELETE_MS;
  78:   const holdMs = opts?.holdMs ?? DEFAULT_HOLD_MS;
  79: 
  80:   // Chave de CONTEÃšDO: o ciclo sÃ³ reinicia se as palavras mudarem de fato,
  81:   // nÃ£o a cada identidade nova de array vinda de um re-render do consumidor.
  82:   const wordsKey = words.join(KEY_SEPARATOR);
  83: 
  84:   // Ref sincronizada para ler a lista atual dentro dos efeitos sem
  85:   // depender da identidade do array (efeito declarado ANTES dos demais
  86:   // para rodar primeiro na ordem de declaraÃ§Ã£o).
  87:   const wordsRef = useRef<readonly string[]>(words);
  88:   useEffect(() => {
  89:     wordsRef.current = words;
  90:   });
  91: 
  92:   // Estado inicial (SSR + primeiro paint + fallback L5): primeira palavra
  93:   // completa, estÃ¡tica.
