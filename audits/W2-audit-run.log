 148: /* ============================================================
 149:    MOTION â€” tudo dentro de no-preference (L5); sÃ³ transform/opacity
 150:    com easing var(--ease) (L10).
 151:    ============================================================ */
 152: @media (prefers-reduced-motion: no-preference) {
 153:   .card::before {
 154:     transition: opacity 0.4s var(--ease);
 155:   }
 156: 
 157:   .video {
 158:     transition: opacity 0.4s var(--ease);
 159:   }
 160: 
 161:   /* Touch: glow acompanha o card ativo in-view (vÃ­deo tocando) */
 162:   .card[data-active="true"]::before {
 163:     opacity: 0.8;
 164:   }
 165: }
 166: 
 167: /* Hover fino (desktop): scale + glow + pill deslizando */
 168: @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
 169:   .card {
 170:     transition: transform 0.4s var(--ease);
 171:   }
 172: 
 173:   .card:hover,
 174:   .card:focus-visible {
 175:     transform: scale(1.05);
 176:   }
 177: 
 178:   .card:hover::before,
 179:   .card:focus-visible::before {
 180:     opacity: 0.8;
 181:   }
 182: 
 183:   .pill {
 184:     opacity: 0;
 185:     transform: translateY(10px);
 186:     transition:
 187:       opacity 0.4s var(--ease),
 188:       transform 0.4s var(--ease);
 189:   }
 190: 
 191:   .card:hover .pill,
 192:   .card:focus-visible .pill {
 193:     opacity: 1;
 194:     transform: translateY(0);
 195:   }
 196: }
