   1: "use client";
   2: 
   3: import {
   4:   createContext,
   5:   useCallback,
   6:   useContext,
   7:   useEffect,
   8:   useMemo,
   9:   useRef,
  10:   useState,
  11:   type ReactNode,
  12: } from "react";
  13: import {
  14:   nextZone,
  15:   validateThreadPlan,
  16:   type ThreadZoneId,
  17: } from "./automation-thread-plan";
  18: import { useMotionOk } from "@/hooks/useMotionOk";
  19: 
  20: /**
  21:  * AutomationThread â€” orquestrador da Linha de AutomaÃ§Ã£o (D3).
  22:  *
  23:  * Responsabilidade Ãºnica: garantir que existe UM ÃšNICO pulso blaze no
  24:  * site inteiro. Os segmentos (AutomationLine) se registram aqui; o
  25:  * Thread decide qual segmento Ã© o dono do pulso e passa o bastÃ£o quando
  26:  * a viagem daquele segmento termina (animationend do offset-distance),
  27:  * seguindo a ordem do THREAD_PLAN com wrap contato â†’ hero.
  28:  *
  29:  * O desenho no scroll Ã© responsabilidade de cada AutomationLine
  30:  * (IO + rAF locais, padrÃ£o FillText) â€” o Thread nÃ£o roda loop prÃ³prio.
  31:  *
  32:  * L5: em reduced-motion nenhum dono Ã© definido â€” pulso nÃ£o existe;
  33:  * cada segmento renderiza a linha 100% desenhada por conta prÃ³pria.
  34:  */
  35: 
  36: interface ThreadContextValue {
  37:   /** Zona dona do Ãºnico pulso do site (null = sem pulso). */
  38:   pulseOwner: ThreadZoneId | null;
  39:   /** Chamado pelo segmento dono quando o pulso completa a viagem. */
  40:   advancePulse: (from: ThreadZoneId) => void;
  41:   register: (zone: ThreadZoneId) => void;
  42:   unregister: (zone: ThreadZoneId) => void;
  43:   motionOk: boolean;
  44: }
  45: 
  46: const ThreadContext = createContext<ThreadContextValue | null>(null);
  47: 
  48: /** Ordem canÃ´nica do fio (para escolher dono inicial e avanÃ§o). */
  49: const ZONE_ORDER: ReadonlyArray<ThreadZoneId> = [
  50:   "hero",
  51:   "services",
  52:   "automation",
  53:   "portfolio",
  54:   "contact",
  55: ];
  56: 
  57: export default function AutomationThread({
  58:   children,
  59: }: {
  60:   children: ReactNode;
  61: }) {
  62:   const motionOk = useMotionOk();
  63:   const registeredRef = useRef<Set<ThreadZoneId>>(new Set());
  64:   const [pulseOwner, setPulseOwner] = useState<ThreadZoneId | null>(null);
  65: 
  66:   // Handshake do plano (contrato D3) â€” barulhento em dev, silencioso em prod.
  67:   useEffect(() => {
  68:     if (process.env.NODE_ENV !== "production") {
  69:       for (const issue of validateThreadPlan()) {
  70:         console.warn(`[AutomationThread] ${issue}`);
  71:       }
  72:     }
  73:   }, []);
  74: 
  75:   /** Primeiro segmento registrado na ordem canÃ´nica do fio. */
  76:   const firstRegistered = useCallback((): ThreadZoneId | null => {
  77:     for (const zone of ZONE_ORDER) {
  78:       if (registeredRef.current.has(zone)) return zone;
  79:     }
  80:     return null;
  81:   }, []);
  82: 
  83:   const register = useCallback(
  84:     (zone: ThreadZoneId) => {
  85:       registeredRef.current.add(zone);
  86:       setPulseOwner((owner) =>
  87:         owner === null || !registeredRef.current.has(owner)
  88:           ? firstRegistered()
  89:           : owner,
  90:       );
  91:     },
  92:     [firstRegistered],
  93:   );
  94: 
  95:   const unregister = useCallback(
  96:     (zone: ThreadZoneId) => {
  97:       registeredRef.current.delete(zone);
  98:       setPulseOwner((owner) => (owner === zone ? firstRegistered() : owner));
  99:     },
 100:     [firstRegistered],
 101:   );
 102: 
 103:   const advancePulse = useCallback((from: ThreadZoneId) => {
 104:     setPulseOwner((owner) => {
 105:       if (owner !== from) return owner; // handoff antigo â€” ignora
 106:       // PrÃ³xima zona REGISTRADA na ordem do fio (wrap incluÃ­do).
 107:       let candidate = nextZone(from);
 108:       for (let i = 0; i < ZONE_ORDER.length; i++) {
 109:         if (registeredRef.current.has(candidate)) return candidate;
 110:         candidate = nextZone(candidate);
 111:       }
 112:       return null;
 113:     });
 114:   }, []);
 115: 
 116:   const value = useMemo<ThreadContextValue>(
 117:     () => ({
 118:       // L5: sem motion nÃ£o hÃ¡ dono â€” nenhum segmento renderiza pulso.
 119:       pulseOwner: motionOk ? pulseOwner : null,
 120:       advancePulse,
 121:       register,
 122:       unregister,
 123:       motionOk,
 124:     }),
 125:     [motionOk, pulseOwner, advancePulse, register, unregister],
 126:   );
 127: 
 128:   return (
 129:     <ThreadContext.Provider value={value}>{children}</ThreadContext.Provider>
 130:   );
 131: }
 132: 
 133: /**
 134:  * Hook interno do AutomationLine. Fora de um AutomationThread devolve um
 135:  * contexto inerte (linha desenha, pulso nÃ£o existe) â€” permite usar um
 136:  * segmento isolado sem quebrar.
 137:  */
 138: export function useAutomationThread(): ThreadContextValue {
 139:   const ctx = useContext(ThreadContext);
 140:   const motionOk = useMotionOk();
 141: 
 142:   const inert = useMemo<ThreadContextValue>(
 143:     () => ({
 144:       pulseOwner: null,
 145:       advancePulse: () => undefined,
 146:       register: () => undefined,
 147:       unregister: () => undefined,
 148:       motionOk,
 149:     }),
 150:     [motionOk],
 151:   );
 152: 
 153:   return ctx ?? inert;
 154: }
