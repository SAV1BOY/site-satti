 132:     if (reducedMotion) {
 133:       return; // L5: reduced-motion â†’ nenhum timer.
 134:     }
 135:     const list = wordsRef.current;
 136:     if (list.length === 0) {
 137:       return;
 138:     }
 139: 
 140:     const { text, phase } = state;
 141:     const word = list[state.wordIndex % list.length] ?? "";
 142: 
 143:     let delay: number;
 144:     let advance: (prev: TypewriterState) => TypewriterState;
