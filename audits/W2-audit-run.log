  95:     text: words[0] ?? "",
  96:     wordIndex: 0,
  97:     phase: "holding",
  98:   }));
  99: 
 100:   // PreferÃªncia de motion como external store: valor real jÃ¡ no primeiro
 101:   // render pÃ³s-hidrataÃ§Ã£o, sem setState em corpo de effect. No servidor e
 102:   // durante a hidrataÃ§Ã£o vale o snapshot "reduced" (estÃ¡tico).
 103:   const reducedMotion = useSyncExternalStore(
 104:     subscribeReducedMotion,
 105:     getReducedMotion,
 106:     getServerReducedMotion,
 107:   );
 108: 
 109:   // (Re)arma o ciclo quando a preferÃªncia de motion muda ou o conjunto de
 110:   // palavras muda â€” ajuste de estado DURANTE o render (padrÃ£o React docs,
 111:   // "adjusting state when props change"), nunca em effect.
 112:   const [prevCycle, setPrevCycle] = useState({
 113:     key: wordsKey,
 114:     reduced: true,
 115:   });
 116:   if (prevCycle.key !== wordsKey || prevCycle.reduced !== reducedMotion) {
 117:     setPrevCycle({ key: wordsKey, reduced: reducedMotion });
 118:     const first = wordsKey.split(KEY_SEPARATOR)[0] ?? "";
