   1: "use client";
   2: 
   3: import { useEffect, useRef, type ElementType, type JSX } from "react";
   4: import styles from "./FillText.module.css";
   5: 
   6: /**
   7:  * FillText â€” assinatura da S5 Sobre: statement em duas camadas
   8:  * sobrepostas. A base fica "apagada" em var(--c-line); a camada de
   9:  * preenchimento (var(--c-iron)) Ã© revelada por
  10:  * `clip-path: inset(0 X% 0 0)` conforme o progresso do elemento pela
  11:  * viewport: comeÃ§a a preencher quando o topo do elemento cruza ~85%
  12:  * da altura da viewport e completa em ~40%.
  13:  *
  14:  * Mecanismo de scroll (L10): IntersectionObserver liga/desliga um
  15:  * loop de requestAnimationFrame que lÃª getBoundingClientRect() no
  16:  * frame â€” sem scroll listener. SÃ³ clip-path muda (nada de layout);
  17:  * clip-path Ã© aceitÃ¡vel aqui pois Ã© o prÃ³prio mecanismo da
  18:  * assinatura fill-text, documentado como exceÃ§Ã£o ao par
  19:  * transform/opacity.
  20:  *
  21:  * L5: o loop sÃ³ roda com (prefers-reduced-motion: no-preference).
  22:  * Em reduced-motion (e sem JS) o fallback estÃ¡tico do CSS Module
  23:  * mantÃ©m o texto 100% preenchido.
  24:  *
  25:  * A11y: a camada .base carrega o texto real; a .fill duplicada Ã©
  26:  * aria-hidden para nÃ£o ser lida duas vezes.
  27:  */
  28: 
  29: /** Topo do elemento a 85% da viewport â†’ progresso 0 (vazio). */
  30: const START_VH = 0.85;
  31: /** Topo do elemento a 40% da viewport â†’ progresso 1 (preenchido). */
  32: const END_VH = 0.4;
  33: 
  34: type FillTextProps = {
  35:   /** Texto do statement (string pura â€” Ã© duplicada nas duas camadas). */
  36:   children: string;
  37:   /** Tag do elemento raiz. Default: 'p'. */
  38:   as?: keyof JSX.IntrinsicElements;
  39:   /** Classe extra do chamador (layout: max-width, margens etc.). */
  40:   className?: string;
  41: };
  42: 
  43: export default function FillText({
  44:   children,
  45:   as = "p",
  46:   className,
  47: }: FillTextProps) {
  48:   const rootRef = useRef<HTMLElement | null>(null);
  49:   const fillRef = useRef<HTMLSpanElement | null>(null);
  50: 
  51:   useEffect(() => {
  52:     const root = rootRef.current;
  53:     const fill = fillRef.current;
  54:     if (!root || !fill) return;
  55: 
  56:     // L5: anima apenas com motion ok. Em reduced-motion nÃ£o escreve
  57:     // clip-path nenhum â€” vale o estado estÃ¡tico 100% preenchido do CSS.
  58:     const motionOk = window.matchMedia(
  59:       "(prefers-reduced-motion: no-preference)",
  60:     ).matches;
  61:     if (!motionOk) return;
  62: 
  63:     let raf = 0;
  64:     let lastRight = -1;
  65: 
  66:     const frame = () => {
  67:       // Leitura no frame (L10): getBoundingClientRect + innerHeight,
  68:       // escrita Ãºnica de clip-path. Passo de 0.1% evita writes inÃºteis.
  69:       const rect = root.getBoundingClientRect();
  70:       const vh = window.innerHeight;
  71:       const start = vh * START_VH;
  72:       const end = vh * END_VH;
  73:       const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end)));
  74:       const right = Math.round((1 - progress) * 1000) / 10;
  75:       if (right !== lastRight) {
  76:         lastRight = right;
  77:         fill.style.clipPath = `inset(0 ${right}% 0 0)`;
  78:       }
  79:       raf = requestAnimationFrame(frame);
  80:     };
  81: 
  82:     // IO ativa/desativa o loop: o rAF sÃ³ roda enquanto o elemento
  83:     // estÃ¡ na viewport (fora dela o estado congela onde parou).
  84:     const io = new IntersectionObserver((entries) => {
  85:       const entry = entries[entries.length - 1];
  86:       if (!entry) return;
  87:       cancelAnimationFrame(raf);
  88:       if (entry.isIntersecting) {
  89:         raf = requestAnimationFrame(frame);
  90:       }
  91:     });
  92:     io.observe(root);
  93: 
  94:     return () => {
  95:       io.disconnect();
  96:       cancelAnimationFrame(raf);
  97:       fill.style.clipPath = "";
  98:     };
  99:   }, []);
 100: 
 101:   const Tag = as as ElementType;
 102: 
 103:   return (
 104:     <Tag
 105:       ref={rootRef}
 106:       className={className ? `${styles.root} ${className}` : styles.root}
 107:     >
 108:       <span className={styles.base}>{children}</span>
 109:       <span className={styles.fill} aria-hidden="true">
 110:         {children}
 111:       </span>
 112:     </Tag>
 113:   );
 114: }
