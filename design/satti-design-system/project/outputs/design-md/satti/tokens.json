  "preview_tokens": {
    "button_primary_bg": "#FF4D00",
    "button_primary_text": "#15171B",
    "button_primary_border": "#FF4D00",
    "button_secondary_bg": "transparent",
    "button_secondary_text": "#15171B",
    "button_secondary_border": "#E3E6EB",
    "button_tertiary_text": "#2F6BFF",
    "surface_bg": "#F7F8FA",
    "card_bg": "#F7F8FA",
    "text": "#15171B",
    "text_muted": "#6E7480",
    "border": "#E3E6EB",
    "accent": "#FF4D00",
    "button_radius": "9999px",
    "card_radius": "28px",
    "input_radius": "12px"
  },
  "components": {
    "button-primary": {
      "bg": "#FF4D00",
      "text": "#15171B",
      "border": "#FF4D00",
      "radius": "9999px",
      "padding": "18px 36px"
    },
    "button-secondary": {
      "bg": "transparent",
      "text": "#15171B",
      "border": "#E3E6EB",
      "radius": "9999px",
      "padding": "17px 36px"
    },
    "card": {
      "radius": "28px",
      "padding": "36px",
      "shadow": "none",
      "variants": {
        "title": {
          "font_weight": "700",
          "font_size": "1.625rem",
          "text": "#15171B"
        },
        "dark": {
          "radius": "28px",
          "padding": "16px",
          "text": "var(--c-ink-on-dark, #F4F5F7)",
          "opacity": "0.8"
        }
      },
      "bg": "#F7F8FA",
      "border": "#E3E6EB"
    },
    "input-text": {
      "bg": "#F7F8FA",
      "text": "#15171B",
      "border": "#E3E6EB",
      "radius": "12px",
      "padding": "0px 18px",
      "focus_border": "#2F6BFF"
    },
    "badge-default": {
      "bg": "transparent",
      "text": "#15171B",
      "border": "#E3E6EB",
      "radius": "9999px",
      "padding": "10px 20px"
    },
    "button": {
      "states": {
        "hover": {
          "transform": "translateY(-1px)",
          "text": "#F4F5F7"
        },
        "focus-visible": {
          "outline": "none",
          "shadow": "0 0 0 2px #F7F8FA, 0 0 0 4px #2F6BFF"
        }
      },
      "variants": {
        "primary": {
          "radius": "999px",
          "padding": "18px 36px",
          "font_weight": "600",
          "font_size": "16px",
          "text": "var(--c-iron, #15171B)",
          "cursor": "pointer",
          "transition": "transform 0.45s cubic-bezier(0.76,0,0.24,1)",
          "transform": "translateY(-1px)",
          "outline": "none",
          "shadow": "0 0 0 2px #F7F8FA, 0 0 0 4px #2F6BFF"
        },
        "secondary": {
          "radius": "999px",
          "padding": "17px 36px",
          "font_weight": "500",
          "font_size": "16px",
          "text": "var(--c-iron, #15171B)",
          "cursor": "pointer",
          "transition": "transform 0.45s cubic-bezier(0.76,0,0.24,1)",
          "outline": "none",
          "shadow": "0 0 0 2px #F7F8FA, 0 0 0 4px #2F6BFF"
        },
        "icon": {
          "radius": "999px",
          "text": "#15171B",
          "cursor": "pointer",
          "transition": "background 0.35s ease, color 0.35s ease"
        }
      }
    },
    "input": {
      "radius": "12px",
      "padding": "0 18px",
      "font_size": "15px",
      "text": "var(--c-iron, #15171B)",
      "states": {
        "focus-visible": {
          "outline": "none",
          "shadow": "0 0 0 3px rgba(47,107,255,0.18)"
        }
      }
    },
    "badge": {
      "font_weight": "400",
      "font_size": "12px",
      "text": "#15171B",
      "radius": "999px",
      "padding": "10px 20px"
    },
    "label": {
      "font_weight": "500",
      "font_size": "0.875rem",
      "text": "#15171B"
    }
  }
}